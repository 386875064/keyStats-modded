<Window x:Class="KeyStats.Views.InsightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:KeyStats.ViewModels"
        xmlns:p="clr-namespace:KeyStats.Properties"
        Title="{x:Static p:Strings.Insights_WindowTitle}"
        Width="780"
        Height="740"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="True">

    <Window.DataContext>
        <viewmodels:InsightsViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{x:Static p:Strings.Insights_HeaderTitle}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{x:Static p:Strings.Insights_HeaderSubtitle}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Typing -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static p:Strings.Insights_TypingTitle}"
                           Style="{DynamicResource CardTitleText}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static p:Strings.Insights_BackspaceRatio}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding BackspaceRatioText}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding BackspaceDetailText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static p:Strings.Insights_ShortcutKeys}" Style="{DynamicResource StatLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ShortcutKeysText}" Style="{DynamicResource StatValue}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Focus -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static p:Strings.Insights_FocusTitle}"
                           Style="{DynamicResource CardTitleText}" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static p:Strings.Insights_AppSwitches}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding AppSwitchesText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static p:Strings.Insights_LongestFocus}" Style="{DynamicResource StatLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LongestFocusText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static p:Strings.Insights_CurrentStreak}" Style="{DynamicResource StatLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentStreakText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{x:Static p:Strings.Insights_LongestStreak}" Style="{DynamicResource StatLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LongestStreakText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static p:Strings.Insights_ActiveTimeFormat}" Style="{DynamicResource StatLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActiveTimeText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Hourly distribution -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static p:Strings.Insights_HourlyTitle}"
                           Style="{DynamicResource CardTitleText}" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding HourBars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="24"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="120" Margin="1,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="2,0" Height="{Binding BarHeight}"
                                        VerticalAlignment="Bottom" CornerRadius="2"
                                        ToolTip="{Binding TooltipText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                    <Setter Property="Opacity" Value="0.18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding HourText}" FontSize="9"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Top apps -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Insights_TopAppsTitle}"
                       Style="{DynamicResource CardTitleText}" Margin="0,0,0,6"/>

            <Grid Grid.Row="1">
                <TextBlock Text="{x:Static p:Strings.Insights_Empty}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ListBox ItemsSource="{Binding TopApps}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasTopApps, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardBorder}" Padding="10,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <Grid Grid.Column="1" Margin="8,0">
                                        <Border x:Name="Track" Background="{DynamicResource SubtleFillBrush}"
                                                CornerRadius="4" Height="14" VerticalAlignment="Center">
                                            <Border x:Name="Fill" Background="{DynamicResource AppStatsKeysBrush}"
                                                    CornerRadius="4" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource BarWidthConverter}">
                                                        <Binding Path="Ratio"/>
                                                        <Binding ElementName="Track" Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding LongestText}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               ToolTip="{x:Static p:Strings.Insights_LongestFocus}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Options -->
        <Border Grid.Row="5" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{x:Static p:Strings.Insights_OptionsTitle}"
                           Style="{DynamicResource CardTitleText}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{x:Static p:Strings.Insights_BreakToggle}"
                              IsChecked="{Binding BreakReminderEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{x:Static p:Strings.Insights_BreakThresholdFormat}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding BreakMinuteOptions}"
                              SelectedItem="{Binding BreakReminderMinutes, Mode=TwoWay}"
                              Width="80" FontSize="12"
                              IsEnabled="{Binding BreakReminderEnabled}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
