<Window x:Class="KeyStats.Views.GameStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:KeyStats.ViewModels"
        xmlns:p="clr-namespace:KeyStats.Properties"
        Title="{x:Static p:Strings.GameStats_WindowTitle}"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="True">

    <Window.DataContext>
        <viewmodels:GameStatsViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static p:Strings.GameStats_HeaderTitle}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{x:Static p:Strings.GameStats_HeaderSubtitle}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Live session card -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusNeutralBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GameName}" FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- APM (primary) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static p:Strings.GameStats_Apm}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding ApmText}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static p:Strings.GameStats_Duration}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding ElapsedText}" Style="{DynamicResource StatValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static p:Strings.GameStats_Keys}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding KeysText}" Style="{DynamicResource StatValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{x:Static p:Strings.GameStats_Clicks}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding ClicksText}" Style="{DynamicResource StatValue}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static p:Strings.GameStats_MouseDistance}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding MouseDistanceText}" Style="{DynamicResource StatValue}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Peak metrics -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static p:Strings.GameStats_AverageApm}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding AverageApmText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static p:Strings.GameStats_LastMinuteApm}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding LastMinuteApmText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static p:Strings.GameStats_PeakApm}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding PeakApmText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{x:Static p:Strings.GameStats_PeakKpm}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding PeakKpmText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static p:Strings.GameStats_PeakCpm}" Style="{DynamicResource StatLabel}"/>
                        <TextBlock Text="{Binding PeakCpmText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding TopKeysText}" FontSize="12" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Options -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static p:Strings.GameStats_OptionsTitle}"
                           Style="{DynamicResource CardTitleText}" Margin="0,0,0,8"/>

                <WrapPanel>
                    <CheckBox Content="{x:Static p:Strings.GameStats_OverlayToggle}"
                              IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"
                              Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Content="{x:Static p:Strings.GameStats_FrontmostToggle}"
                              IsChecked="{Binding FrontmostOnly, Mode=TwoWay}"
                              Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Content="{x:Static p:Strings.GameStats_MergeToggle}"
                              IsChecked="{Binding MergeIntoDaily, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </WrapPanel>

                <TextBlock Text="{x:Static p:Strings.GameStats_MergeHint}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ElevationBadgeText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="{x:Static p:Strings.GameStats_RestartElevated}"
                            Style="{DynamicResource GhostButton}"
                            Command="{Binding RestartElevatedCommand}"
                            Visibility="{Binding ShowRestartElevated, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Capture status -->
        <Border Grid.Row="4" Padding="10,8" CornerRadius="6" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CaptureWarning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static p:Strings.GameStats_CaptureHealth}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CaptureStatusText}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ChannelText}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- History header -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static p:Strings.GameStats_SessionList}"
                           Style="{DynamicResource CardTitleText}"/>
                <TextBlock Text="{Binding HistorySummaryText}" Style="{DynamicResource SecondaryText}"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{x:Static p:Strings.GameStats_DoubleClickHint}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource SubtleFillBrush}" CornerRadius="6"
                    Padding="3" Margin="0,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{x:Static p:Strings.AppStats_RangeToday}" GroupName="GameStatsRange"
                                 Style="{DynamicResource SegmentedButton}" FontSize="11" Padding="10,4"
                                 IsChecked="{Binding SelectedRangeIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"/>
                    <RadioButton Content="{x:Static p:Strings.AppStats_Range7Days}" GroupName="GameStatsRange"
                                 Style="{DynamicResource SegmentedButton}" FontSize="11" Padding="10,4"
                                 IsChecked="{Binding SelectedRangeIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"/>
                    <RadioButton Content="{x:Static p:Strings.AppStats_Range30Days}" GroupName="GameStatsRange"
                                 Style="{DynamicResource SegmentedButton}" FontSize="11" Padding="10,4"
                                 IsChecked="{Binding SelectedRangeIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"/>
                    <RadioButton Content="{x:Static p:Strings.AppStats_RangeAll}" GroupName="GameStatsRange"
                                 Style="{DynamicResource SegmentedButton}" FontSize="11" Padding="10,4"
                                 IsChecked="{Binding SelectedRangeIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Content="{x:Static p:Strings.GameStats_ClearHistory}"
                    Style="{DynamicResource DangerGhostButton}"
                    Command="{Binding ClearHistoryCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- History list -->
        <Grid Grid.Row="6">
            <TextBlock Text="{x:Static p:Strings.GameStats_Empty}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <ListBox ItemsSource="{Binding SessionItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorder}" Padding="10,8" Margin="0,0,0,4"
                                Cursor="Hand" MouseLeftButtonDown="SessionRow_MouseLeftButtonDown">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Static p:Strings.GameStats_Duration}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Static p:Strings.GameStats_Keys}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding KeysText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Static p:Strings.GameStats_Clicks}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding ClicksText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Static p:Strings.GameStats_Apm}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding ApmText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding TopKeysText}" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
