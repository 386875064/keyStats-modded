<Window x:Class="KeyStats.Views.GameSessionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对局详情"
        Width="520" Height="640"
        MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="False">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 英雄 + 时间 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="72" Height="72" CornerRadius="10" ClipToBounds="True"
                    Background="{DynamicResource DividerBrush}">
                <Grid>
                    <TextBlock Text="?" FontSize="24" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Image x:Name="IconImage" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <StackPanel Margin="14,4,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ChampionNameText" Text="未知英雄" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="DateText" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="DurationText" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- 汇总 -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="0,16,0,10" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="按键" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="KeyPressesText" Text="0" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="点击（左/右/中/侧）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ClicksText" Text="0" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="APM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ApmText" Text="0" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <TextBlock Text="峰值 APM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="PeakApmText" Text="0" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <TextBlock Text="采集通道" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ChannelText" Text="—" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 逐键标题 -->
        <TextBlock x:Name="KeyListHeader" Grid.Row="2" Text="本局逐键分布" FontSize="13" FontWeight="SemiBold"
                   Margin="2,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 逐键列表 -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorder}" Padding="12,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="KeyList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
                                           Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
