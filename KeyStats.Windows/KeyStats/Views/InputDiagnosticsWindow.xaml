<Window x:Class="KeyStats.Views.InputDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入诊断"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="False">

    <StackPanel Margin="24,20">

        <TextBlock Text="输入诊断" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="实时查看统计是否在工作、走的是哪条通道"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,2,0,14"/>

        <!-- 通道状态 -->
        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="14,12">
            <StackPanel>
                <TextBlock Text="当前采集通道" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="ChannelText" Text="—" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                <TextBlock x:Name="ChannelHintText" Text="" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Raw Input 通道" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="RawReadyText" Grid.Column="1" Text="—" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="监听状态" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="MonitoringText" Grid.Column="1" Text="—" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 实时信号 -->
        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="14,12">
            <StackPanel>
                <TextBlock Text="实时信号" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最近一次输入" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="LastInputText" Grid.Column="1" Text="—" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最近 10 秒事件数" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="RecentEventsText" Grid.Column="1" Text="0" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
                <ProgressBar x:Name="RecentEventsBar" Height="5" Margin="0,6,0,0"
                             Minimum="0" Maximum="60" Value="0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前前台程序" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ForegroundAppText" Grid.Column="1" Text="—" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="240"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 今日累计 -->
        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="14,12">
            <StackPanel>
                <TextBlock Text="今日累计" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="按键" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TodayKeysText" Text="0" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="点击" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TodayClicksText" Text="0" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="鼠标移动" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TodayDistanceText" Text="0" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="SessionText" Text="" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,2,0,0"/>
    </StackPanel>
</Window>
