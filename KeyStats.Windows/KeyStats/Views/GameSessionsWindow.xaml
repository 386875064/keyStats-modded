<Window x:Class="KeyStats.Views.GameSessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对局记录"
        Width="640" Height="560"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="False">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="对局记录" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="检测到游戏运行时自动开一局，退出后结算本局的按键、点击与移动距离"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,2,0,12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 汇总 -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="0,0,0,10" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="场次" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TotalSessionsText" Text="0" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="总时长" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TotalDurationText" Text="0h" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="累计按键" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TotalKeysText" Text="0" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="平均 APM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="AverageApmText" Text="0" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="8,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SessionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Width="120">
                                    <TextBlock Text="{Binding DateText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding KeyPresses, StringFormat={}{0:N0}}"/>
                                        <Run Text=" 键 · "/>
                                        <Run Text="{Binding TotalClicks, StringFormat={}{0:N0}}"/>
                                        <Run Text=" 击"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="APM "/>
                                        <Run Text="{Binding ApM, StringFormat={}{0:F0}}"/>
                                        <Run Text=" · 峰值 "/>
                                        <Run Text="{Binding PeakApm}"/>
                                        <Run Text=" · 通道 "/>
                                        <Run Text="{Binding ChannelText}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource DividerBrush}">
                                    <TextBlock Text="{Binding GameName}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyHintText" Grid.Row="2" Text="还没有对局记录"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Window>
