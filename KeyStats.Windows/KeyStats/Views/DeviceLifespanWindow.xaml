<Window x:Class="KeyStats.Views.DeviceLifespanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyStats.Views.Controls"
        Title="设备寿命"
        Width="980" Height="760"
        MinWidth="860" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurfaceBrush}"
        ShowInTaskbar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20">

        <TextBlock Text="设备寿命" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="根据累计按键与点击，对比轴体 / 微动的厂商标称寿命，逐键估算剩余情况"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,2,0,14"/>

        <!-- 汇总：键盘 / 鼠标 两张卡 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,4,0" Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="键盘" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="KeyboardBigPercent"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                    <ComboBox x:Name="KeyboardTypeComboBox" Margin="0,8,0,0"
                              DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectionChanged="DeviceType_SelectionChanged"/>
                    <StackPanel x:Name="KeyboardCustomPanel" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="额定寿命（万次）" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="KeyboardCustomTextBox" Width="90" Margin="8,0,0,0"
                                 HorizontalContentAlignment="Right" LostFocus="CustomRated_LostFocus"/>
                    </StackPanel>
                    <ProgressBar x:Name="KeyboardLifespanBar" Height="6" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100" Value="100"/>
                    <TextBlock x:Name="KeyboardLifespanText" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="KeyboardLifespanDaysText" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Margin="4,0,0,0" Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="鼠标" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="MouseBigPercent"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                    <ComboBox x:Name="MouseTypeComboBox" Margin="0,8,0,0"
                              DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectionChanged="DeviceType_SelectionChanged"/>
                    <StackPanel x:Name="MouseCustomPanel" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="额定寿命（万次）" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="MouseCustomTextBox" Width="90" Margin="8,0,0,0"
                                 HorizontalContentAlignment="Right" LostFocus="CustomRated_LostFocus"/>
                    </StackPanel>
                    <ProgressBar x:Name="MouseLifespanBar" Height="6" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100" Value="100"/>
                    <TextBlock x:Name="MouseLifespanText" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="MouseLifespanDaysText" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 键盘逐键寿命 -->
        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="键盘 · 逐键磨损" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="2" Background="#43A047" Margin="0,0,4,0"/>
                        <TextBlock Text="健康" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <Border Width="10" Height="10" CornerRadius="2" Background="#E69138" Margin="0,0,4,0"/>
                        <TextBlock Text="过半" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <Border Width="10" Height="10" CornerRadius="2" Background="#D14841" Margin="0,0,4,0"/>
                        <TextBlock Text="磨损严重" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="键帽颜色 = 该键已用次数占额定寿命的比例，角标为剩余百分比"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                <Border Height="300">
                    <controls:KeyboardHeatmapControl x:Name="KeyboardLifespanView"/>
                </Border>
                <TextBlock x:Name="KeyboardWearSummary" FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 鼠标按键寿命 -->
        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8" Padding="14,12">
            <StackPanel>
                <TextBlock Text="鼠标 · 按键磨损" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="左 / 右键按所选微动寿命估算；中键与侧键通常沿用鼠标原装微动，固定按 500 万次估算"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"
                           TextWrapping="Wrap"/>
                <Border Height="190">
                    <controls:MouseLifespanControl x:Name="MouseLifespanView"/>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="说明：寿命次数为厂商标称典型值，实际寿命受使用习惯影响，仅供参考；统计口径为本地累计数据"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="2,0,0,4"/>

      </StackPanel>
    </ScrollViewer>
</Window>
